<Window x:Class="Undertale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Undertale"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Black">
        <StackPanel x:Name="SansContainer" Background="Blue" Width="100" Height="150" Margin="350,0,350,260"/>

        <Border BorderBrush="White" BorderThickness="5" Background="Black" Width="700" Height="120" Margin="50,150,50,90" Padding="10">
            <StackPanel x:Name="DialogueBox">
                <TextBlock x:Name="Dialogue" FontSize="20" Text="* This is Lorem Ipsum" Foreground="White" FontFamily="Comic Sans MS" Padding="10"/>
            </StackPanel>
        </Border>
        <StackPanel x:Name="Info" Height="30" Margin="50,310,50,84" Background="Yellow"/>
        <StackPanel x:Name="ButtonGrid" VerticalAlignment="Bottom" Width="700" Height="70"  Margin="50,0,50,10">
            <UniformGrid Rows="1" Columns="4" Height="60" Margin="-5">
                <Button FontSize="30" Padding="-3" Content="FIGHT" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Padding="-3" Content="ACT" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Padding="-3" Content="ITEM" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Padding="-3" Content="MERCY" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
