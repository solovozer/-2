<Window x:Class="Undertale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Undertale"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="SansContainer" Background="Blue" Width="100" Height="130" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Border BorderBrush="White" BorderThickness="5" Background="Black" Width="700" HorizontalAlignment="Center" Grid.Row="1" Padding="10" Margin="0,15,0,0" Grid.RowSpan="2">
            <StackPanel x:Name="DialogueBox">
                <TextBlock x:Name="Dialogue" FontSize="20" Text="* This is Lorem Ipsum" Foreground="White" FontFamily="Comic Sans MS" Padding="10"/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="Info" Width="700" HorizontalAlignment="Center" Grid.Row="3" Background="Yellow" Margin="0,24,0,10"/>

        <StackPanel x:Name="ButtonGrid" Grid.Row="4" Width="700" HorizontalAlignment="Center">
            <UniformGrid Rows="1" Columns="4" Height="60" Margin="-5">
                <Button FontSize="30" Content="FIGHT" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Content="ACT" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Content="ITEM" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
                <Button FontSize="30" Content="MERCY" Background="Black" Foreground="Orange" BorderBrush="Orange" BorderThickness="7" Margin="5"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
